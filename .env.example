GEMINI_API_KEY=
VITE_BRAIN_API_URL=
# Server bind host (defaults to 127.0.0.1 for local security; set BRAIN_ALLOW_LAN=true or BRAIN_HOST=0.0.0.0 to allow LAN access)
BRAIN_HOST=127.0.0.1
BRAIN_ALLOW_LAN=false
# Optional: set BRAIN_SEED_DEMO=true to seed sample facts on an empty database
BRAIN_SEED_DEMO=false
